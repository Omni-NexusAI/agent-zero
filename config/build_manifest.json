                "python/helpers/plugins.py",
                "python/helpers/extension.py",
                "run_ui.py"
            ],
            "markers": [
                {
                    "path": "plugins/_agentspine_identity/plugin.yaml",
                    "must_include": [
                        "name: _agentspine_identity",
                        "always_enabled: true"
                    ]
                },
                {
                    "path": "plugins/_agentspine_identity/default_config.yaml",
                    "must_include": [
                        "product_name: Agentspine",
                        "default_release_tag: v0.9.9-standard-pre"
                    ]
                },
                {
                    "path": "python/helpers/build_info.py",
