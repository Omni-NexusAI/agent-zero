                        "format_display_version"
                    ]
                },
                {
                    "path": "python/helpers/plugins.py",
                    "must_include": [
                        "render_webui_extension_tags",
                        "extensions\", \"webui\""
                    ]
                },
                {
                    "path": "run_ui.py",
                    "must_include": [
                        "plugins.render_webui_extension_tags(index, agent=None)"
                    ]
                }
            ]
        },
