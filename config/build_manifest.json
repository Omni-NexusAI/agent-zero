    "features": [
        {
            "name": "agentspine_identity_module",
            "description": "Built-in Agentspine identity overlay owns visible branding and AS banner formatting while preserving A0 compatibility.",
            "required_paths": [
                "plugins/_agentspine_identity/plugin.yaml",
